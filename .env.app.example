

############
# De Groene Weide – app and server settings
# (scripts/init-env.sh appends this to the Supabase settings above)
############

# Domains for the server stack (compose.prod.yaml). Caddy gets HTTPS
# certificates for both. On the server, also set above:
#   SITE_URL=https://<SITE_DOMAIN>
#   SUPABASE_PUBLIC_URL=https://<API_DOMAIN>
#   API_EXTERNAL_URL=https://<API_DOMAIN>/auth/v1
# and replace the SMTP_* values with a real EU mail provider.
SITE_DOMAIN=degroeneweide.example
API_DOMAIN=api.degroeneweide.example

# Where contact form messages go (Bert's inbox). In development every mail
# lands in Mailpit (http://localhost:8025) whatever this says. Mail is sent
# from SMTP_ADMIN_EMAIL above, so set that to an address on the domain.
CONTACT_EMAIL=bert@degroeneweide.example

# Shared secret for the jobs endpoint (/api/jobs), used by the cron service.
# scripts/init-env.sh fills it in.
JOBS_SECRET=
# Signs the guest's manage link in the booking emails. Changing it breaks
# the links in mails that were already sent. scripts/init-env.sh fills it in.
MANAGE_LINK_SECRET=
# Optional: a Facebook page access token (pages_read_engagement) to show
# Bert's latest posts on the site. Empty = the site links to the page.
FACEBOOK_PAGE_TOKEN=
